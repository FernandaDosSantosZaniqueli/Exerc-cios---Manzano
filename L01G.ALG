Algoritmo "L01G"
// Disciplina   : [Lógica de Programação]
// Professor   : Jailson
// Descrição   : Ler quatro números inteiros e apresentar o resultado da adição e multiplicação, baseando-se na
//utilização do conceito da propriedade distributiva. Ou seja, se forem lidas as variáveis A, B, C, e D,
//devem ser somadas e multiplicadas A com B, A com C e A com D. Depois B com C, B com D e por fim
//C com D. Perceba que será necessário efetuar seis operações de adição e seis operações de
//multiplicação e apresentar doze resultados de saída.
// Autor(a)    : Fernanda
// Data atual  : 16/09/2026
Var
   // Seção de Declarações das variáveis
   A, B, C, D:inteiro

Inicio
   // Seção de Comandos, procedimento, funções, operadores, etc...
   Escreval("======= Adição e multiplicação =======")
   escreval("")
   escreval("Digite o valor A: ")
   leia(A)
   escreval("")
   escreval("Digite o valor B: ")
   leia(B)
   escreval("")
   escreval("Digite o valor C: ")
   leia(C)
   escreval("")
   escreval("Digite o valor D: ")
   leia(D)
   escreval("")
   escreval("A adição de A e B é: ", A+B)
   escreval("")
   escreval("A adição de A e C é: ", A+C)
   escreval("")
   escreval("A adição de A e D é: ", A+D)
   escreval("")
   escreval("A adição de B e C é: ", B+C)
   escreval("")
   escreval("A adição de B e D é: ", B+D)
   escreval("")
   escreval("A adição de C e D é: ", C+D)
   escreval("")
   escreval("A multiplicação de A e B é: ", A*B)
   escreval("")
   escreval("A multiplicação de A e C é: ", A*C)
   escreval("")
   escreval("A multiplicação de A e D é: ", A*D)
   escreval("")
   escreval("A multiplicação de B e C é: ", B*C)
   escreval("")
   escreval("A multiplicação de B e D é: ", B*D)
   escreval("")
   escreval("A multiplicação de C e D é: ", C*D)
   escreval("")
Fimalgoritmo